{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "twindock.main:app",
      "buildCommand": "rm -rf shared hardware simtools && mkdir -p shared hardware simtools && cp -R ../shared/schemas shared/schemas && cp -R ../hardware/kits hardware/kits && cp ../tools/site_sim.py ../tools/sim_models.py simtools/"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/ws", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
