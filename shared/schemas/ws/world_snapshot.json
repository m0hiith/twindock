{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twindock/ws/world_snapshot.json",
  "title": "world_snapshot (server -> client)",
  "description": "Full state, sent on connect and after a reset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "seq",
    "server_ts_ms",
    "layout_version",
    "auto_mode",
    "selected_unit_id",
    "units",
    "gateway",
    "sites",
    "devices"
  ],
  "properties": {
    "type": {
      "const": "world_snapshot"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "server_ts_ms": {
      "type": "integer"
    },
    "layout_version": {
      "type": "string"
    },
    "auto_mode": {
      "type": "boolean"
    },
    "selected_unit_id": {
      "anyOf": [
        {
          "$ref": "defs.json#/$defs/unit_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/unit"
      }
    },
    "gateway": {
      "$ref": "defs.json#/$defs/gateway"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/site"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/device"
      }
    }
  }
}
