{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twindock/ws/defs.json",
  "title": "Shared definitions for WebSocket messages",
  "$defs": {
    "cmd_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}-[0-9]{2}$",
      "description": "e.g. FL-01, TR-02, PL-07, GW-01, M-01 (machine), WK-01 (worker)"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Waypoint graph node, e.g. DOCK_1, RACK_A3, CHARGER_C1, GATE_IN"
    },
    "source": {
      "enum": [
        "device",
        "manual",
        "auto",
        "sim"
      ],
      "description": "device = real board data; sim = produced by tools/site_sim.py, never real."
    },
    "kind": {
      "enum": [
        "forklift",
        "truck",
        "pallet",
        "dock",
        "rack",
        "charger",
        "gateway",
        "machine",
        "worker"
      ]
    },
    "forklift_state": {
      "enum": [
        "idle",
        "driving",
        "picking",
        "carrying",
        "loading",
        "charging"
      ]
    },
    "truck_state": {
      "enum": [
        "arriving",
        "docked",
        "loading",
        "departing",
        "gone"
      ]
    },
    "dock_state": {
      "enum": [
        "available",
        "occupied",
        "maintenance"
      ]
    },
    "timed": {
      "description": "A device value plus when the backend received it. Absent/null means no message has arrived yet.",
      "type": "object",
      "required": [
        "received_ms"
      ],
      "properties": {
        "received_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "state",
        "x",
        "z",
        "heading_rad"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/unit_id"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "state": {
          "type": "string",
          "description": "One of the state enums for this kind."
        },
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "description": "Meters east of the NW corner."
        },
        "z": {
          "type": "number",
          "description": "Meters south of the NW corner."
        },
        "heading_rad": {
          "type": "number",
          "description": "0 = facing +x (east), increasing towards +z."
        },
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/node_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Node the unit is at, null while between nodes."
        },
        "target_node": {
          "anyOf": [
            {
              "$ref": "#/$defs/node_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node_id"
          },
          "description": "Remaining nodes to the target."
        },
        "task": {
          "type": "string",
          "description": "One-line human task, e.g. \"Loading truck TR-01\"."
        },
        "battery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "carrying": {
          "anyOf": [
            {
              "$ref": "#/$defs/unit_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "docked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/node_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Static display fields (operator, model, plate...)."
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/$defs/unit_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pallets only: the forklift carrying it or the truck it is loaded on."
        },
        "cargo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit_id"
          },
          "description": "Trucks only: pallets on board."
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan_step"
          },
          "description": "Forklifts: queued steps. BTN0 runs the first one."
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "online",
        "fake",
        "hello",
        "status",
        "buttons",
        "leds",
        "ble",
        "sensors"
      ],
      "properties": {
        "online": {
          "type": "boolean",
          "description": "False when twin/gateway/status is older than 15 s or never received."
        },
        "fake": {
          "type": "boolean",
          "description": "True when hello.fw_version == \"fake\". The UI must show a FAKE BOARD banner."
        },
        "last_seen_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "hello": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/timed"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "../mqtt/gateway_hello.json"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              ]
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/timed"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "../mqtt/gateway_status.json"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              ]
            }
          ]
        },
        "buttons": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/timed"
              },
              {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "pressed",
                      "released"
                    ]
                  }
                }
              }
            ]
          }
        },
        "leds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "on",
              "received_ms",
              "pending"
            ],
            "properties": {
              "on": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Last confirmed state; null if never confirmed."
              },
              "received_ms": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pending": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "cmd_id",
                      "on",
                      "sent_ms"
                    ],
                    "properties": {
                      "cmd_id": {
                        "type": "string"
                      },
                      "on": {
                        "type": "boolean"
                      },
                      "sent_ms": {
                        "type": "integer"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "ble": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/timed"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "../mqtt/gateway_ble.json"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              ]
            }
          ]
        },
        "sensors": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/timed"
              },
              {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "../mqtt/gateway_sensor.json"
                  }
                },
                "required": [
                  "data"
                ]
              }
            ]
          }
        }
      }
    },
    "plan_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "action"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/node_id"
        },
        "action": {
          "enum": [
            "goto",
            "pick",
            "drop",
            "load",
            "charge",
            "dock",
            "depart"
          ]
        }
      }
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{2}$",
      "description": "e.g. WH-01, FAC-01. Never 'gateway', so twin/gateway/* can't be a site topic."
    },
    "zone_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "e.g. FAC01_PRODUCTION"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-[0-9]{2}$",
      "description": "e.g. GW-01 (the real board), MM-01, BG-03"
    },
    "device_type": {
      "enum": [
        "gateway",
        "machine_monitor",
        "env_sensor",
        "door_sensor",
        "occupancy_sensor",
        "badge",
        "asset_tag",
        "power_meter",
        "light",
        "air_quality"
      ]
    },
    "protocol": {
      "enum": [
        "wifi",
        "ble",
        "thread",
        "matter"
      ]
    },
    "device_status": {
      "enum": [
        "online",
        "stale",
        "offline",
        "fault"
      ],
      "description": "online: last message <= 15 s old; stale: <= 60 s; offline: older or never; fault: the device reports a fault."
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "zone_kind": {
      "enum": [
        "storage",
        "docks",
        "production",
        "cold_room",
        "office",
        "yard"
      ]
    },
    "xz": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, z] in metres"
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "site_id",
        "name",
        "kind",
        "polygon"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/zone_id"
        },
        "site_id": {
          "$ref": "#/$defs/site_id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/zone_kind"
        },
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xz"
          },
          "minItems": 3
        },
        "restricted_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "If present, only these worker roles may enter (S3)."
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "short",
        "kind",
        "layout_ref",
        "bounds",
        "zones"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/site_id"
        },
        "name": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "warehouse",
            "factory",
            "mixed"
          ]
        },
        "layout_ref": {
          "type": "string"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "z"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/xz"
            },
            "z": {
              "$ref": "#/$defs/xz"
            }
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          }
        },
        "home": {
          "$ref": "#/$defs/xz",
          "description": "Camera target for this site."
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "received_ms"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "number",
                "boolean",
                "string"
              ]
            },
            {
              "$ref": "#/$defs/xz"
            }
          ]
        },
        "unit": {
          "type": "string"
        },
        "received_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "site_id",
        "zone_id",
        "type",
        "protocol",
        "capabilities",
        "x",
        "z",
        "last_seen_ms",
        "source",
        "status",
        "readings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "site_id": {
          "$ref": "#/$defs/site_id"
        },
        "zone_id": {
          "$ref": "#/$defs/zone_id"
        },
        "type": {
          "$ref": "#/$defs/device_type"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "attached_to": {
          "$ref": "#/$defs/unit_id",
          "description": "Unit the device is mounted on or worn by (M-01, WK-02...)."
        },
        "battery_pct": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "fw_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rssi_dbm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -127,
              "maximum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Backend time of the last message; null if never."
        },
        "source": {
          "enum": [
            "device",
            "sim"
          ]
        },
        "status": {
          "$ref": "#/$defs/device_status"
        },
        "fault": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "readings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/reading"
          },
          "description": "Latest value per channel, each with its own receive time."
        },
        "kit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Id of the device kit (hardware/kits/<id>.json) this device is built from. One kit design, many devices."
        }
      }
    }
  }
}
