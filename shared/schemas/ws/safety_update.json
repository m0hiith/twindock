{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twindock/ws/safety_update.json",
  "title": "safety_update (server -> client)",
  "description": "Worker safety from badges: proximity (with direction), restricted zones and time limits, falls/man-down, SOS, lone-worker check-ins, gas evacuation and evacuation headcount, today's counters. Workers are identified by id and role only (no names). Position and zone are only sent while that worker has an active safety condition or an evacuation is running (location_shown); otherwise screens get zone counts. On connect and at most 2 Hz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "breaks_due",
    "config",
    "evacuation",
    "gas_zones",
    "heat_zones",
    "in_hazardous",
    "on_site",
    "ppe_reminders",
    "privacy",
    "routes",
    "seq",
    "server_ts_ms",
    "today",
    "type",
    "workers",
    "zone_counts"
  ],
  "properties": {
    "type": {
      "const": "safety_update"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "server_ts_ms": {
      "type": "integer"
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "badge_id",
          "data_ms",
          "evacuate",
          "first_aider",
          "fresh",
          "id",
          "location_shown",
          "lone",
          "man_down",
          "mustered",
          "near",
          "nearest_first_aider",
          "prealert",
          "restricted_zone",
          "role",
          "sos_ms",
          "x",
          "z",
          "zone_id",
          "zone_overtime_min"
        ],
        "properties": {
          "id": {
            "$ref": "defs.json#/$defs/unit_id"
          },
          "role": {
            "type": "string"
          },
          "badge_id": {
            "$ref": "defs.json#/$defs/device_id"
          },
          "zone_id": {
            "anyOf": [
              {
                "$ref": "defs.json#/$defs/zone_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "x": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "z": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "fresh": {
            "type": "boolean",
            "description": "Badge online (last position at most 15 s old)."
          },
          "data_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "near": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "forklift",
                  "distance_m",
                  "level"
                ],
                "properties": {
                  "forklift": {
                    "type": "string"
                  },
                  "distance_m": {
                    "type": "number"
                  },
                  "level": {
                    "enum": [
                      "warning",
                      "critical"
                    ]
                  },
                  "reversing": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "restricted_zone": {
            "anyOf": [
              {
                "$ref": "defs.json#/$defs/zone_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "prealert": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "deadline_ms"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "fall",
                      "no_motion"
                    ]
                  },
                  "deadline_ms": {
                    "type": "integer"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "man_down": {
            "anyOf": [
              {
                "enum": [
                  "fall",
                  "no_motion"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "sos_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "evacuate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "lone": {
            "anyOf": [
              {
                "enum": [
                  "warning",
                  "critical"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "zone_overtime_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "first_aider": {
            "type": "boolean"
          },
          "nearest_first_aider": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "distance_m"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "distance_m": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "mustered": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "location_shown": {
            "type": "boolean"
          }
        }
      }
    },
    "zone_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Workers with a fresh badge per zone id."
    },
    "today": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closest",
        "closest_m",
        "criticals",
        "falls",
        "falls_cancelled",
        "last_fall_ms",
        "last_sos_ms",
        "restricted",
        "sos",
        "warnings"
      ],
      "properties": {
        "warnings": {
          "type": "integer"
        },
        "criticals": {
          "type": "integer"
        },
        "restricted": {
          "type": "integer"
        },
        "closest_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "closest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "worker",
                "forklift",
                "at_ms"
              ],
              "properties": {
                "worker": {
                  "$ref": "defs.json#/$defs/unit_id"
                },
                "forklift": {
                  "$ref": "defs.json#/$defs/unit_id"
                },
                "at_ms": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "falls": {
          "type": "integer",
          "minimum": 0
        },
        "falls_cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "sos": {
          "type": "integer",
          "minimum": 0
        },
        "last_fall_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sos_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warn_m",
        "crit_m"
      ],
      "properties": {
        "warn_m": {
          "type": "number"
        },
        "crit_m": {
          "type": "number"
        }
      }
    },
    "evacuation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "started_ms",
            "reason",
            "by",
            "on_site",
            "accounted",
            "by_muster",
            "unaccounted"
          ],
          "properties": {
            "active": {
              "const": true
            },
            "started_ms": {
              "type": "integer"
            },
            "reason": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "on_site": {
              "type": "integer"
            },
            "accounted": {
              "type": "integer"
            },
            "by_muster": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "unaccounted": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "role",
                  "last_zone_id",
                  "last_seen_ms"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "last_zone_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "last_seen_ms": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "predicted_s": {
              "type": [
                "number",
                "null"
              ],
              "description": "Predicted time to muster everyone: the longest walkway distance to a safe muster point ÷ the evacuation planning speed, when the evacuation started."
            },
            "accounted_ms": {
              "type": [
                "integer",
                "null"
              ],
              "description": "When the last person on site reached a muster point (null until then)."
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "on_site": {
      "type": "integer",
      "minimum": 0
    },
    "in_hazardous": {
      "type": "integer",
      "minimum": 0
    },
    "gas_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heat_zones": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "ppe_reminders": {
      "type": "integer",
      "minimum": 0,
      "description": "Badges currently reminded about missing PPE. A count only: who it is is never sent or stored."
    },
    "breaks_due": {
      "type": "integer",
      "minimum": 0,
      "description": "How many workers are due a break. Who is only served to the worker and the supervisor."
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "retention_days"
      ],
      "properties": {
        "location": {
          "enum": [
            "alerts_only",
            "always"
          ]
        },
        "retention_days": {
          "type": "number"
        }
      }
    },
    "routes": {
      "type": "array",
      "description": "While an evacuation runs or a gas alarm is on: per zone with people (and the hazard zones), the walking route to the nearest muster point that is not next to the hazard. Advice only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "muster_id",
          "length_m",
          "points"
        ],
        "properties": {
          "zone_id": {
            "type": "string"
          },
          "muster_id": {
            "type": "string"
          },
          "length_m": {
            "type": "number"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
