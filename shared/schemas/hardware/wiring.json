{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twindock/hardware/wiring.json",
  "title": "hardware/wiring.json",
  "description": "Single source of truth for how the forklift sensor pack is connected. Firmware pins (tools/gen_pins.py), the /wiring page and docs/hardware_sheet.pdf are all generated from it. Nothing here may be guessed: a value that is not confirmed from the SDK, a datasheet or the developer is null and its `evidence` is \"unverified\".",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "board", "sdk", "buses", "parts", "connections", "open_questions"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "pin_ref": {
      "description": "<part id>.<pin name>, e.g. soc.ULP_GPIO_6 or vl53l1x.qwiic_in.SDA",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[A-Za-z0-9_.+-]+$"
    },
    "evidence": {
      "description": "sdk-verified: found in the SDK board config (cite `source`). datasheet: from the part's datasheet or a published spec (Qwiic). confirmed: also checked by the developer on the hardware. unverified: not confirmed, must not be used by firmware.",
      "enum": ["sdk-verified", "datasheet", "confirmed", "unverified"]
    },
    "voltage_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_v", "max_v"],
      "properties": {
        "min_v": { "type": "number" },
        "max_v": { "type": "number" }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "signal", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Pin name on this part (SDA, MOSI, qwiic_in.SDA, ULP_GPIO_6)." },
        "signal": { "type": "string", "minLength": 1, "description": "Function: SDA, SCL, MOSI, MISO, SCK, CS, INT, 3V3, GND, EN, ..." },
        "gpio": { "type": ["string", "null"], "description": "SoC GPIO name when this pin is on the SoC or wired to it, else null." },
        "x_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Position on frontend/public/board/top.jpg (on-board parts and board pads only)." },
        "y_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "source": { "type": "string", "description": "File or document the value came from." }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "board": { "type": "string", "minLength": 1 },
    "sdk": { "type": "string", "minLength": 1 },
    "buses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "controller", "voltage_v", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "kind": { "enum": ["i2c", "spi", "i2s", "gpio", "power", "analog"] },
          "controller": { "type": ["string", "null"], "description": "SoC peripheral, e.g. I2C2 (ULP_I2C). null when not known." },
          "voltage_v": { "type": ["number", "null"] },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "part_number", "quantity", "location", "kind", "bus", "address", "status", "pins"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "part_number": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "location": { "enum": ["on-board", "external"] },
          "kind": { "enum": ["soc", "sensor", "connector", "module", "transducer"] },
          "bus": { "type": ["string", "null"], "description": "Bus id from `buses`, or null (SoC, connectors, analog parts)." },
          "address": {
            "type": ["string", "null"],
            "pattern": "^0x[0-9A-F]{2}$",
            "description": "7-bit I2C address as 0xNN, or null for non-I2C parts."
          },
          "address_evidence": { "$ref": "#/$defs/evidence" },
          "supply": { "$ref": "#/$defs/voltage_range", "description": "Allowed supply range from the datasheet." },
          "supplied_from": { "type": ["string", "null"], "description": "Bus id of the power rail feeding this part." },
          "enable_pin": { "type": ["string", "null"], "description": "pin_ref of a power/enable pin that must be driven before use." },
          "sdk_driver": { "type": ["string", "null"] },
          "sdk_example": { "type": ["string", "null"] },
          "measures": { "type": "string" },
          "forklift_use": { "type": "string" },
          "topics": {
            "type": "array",
            "items": { "type": "string", "pattern": "^twin/gateway/" },
            "description": "MQTT topics this part feeds. Each must exist in /shared (checked in W5)."
          },
          "outline_pct": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" }, "y": { "type": "number" },
              "w": { "type": "number" }, "h": { "type": "number" }
            },
            "description": "Outline on top.jpg in % for on-board parts. null until measured from the photo."
          },
          "status": {
            "enum": ["planned", "wired", "verified"],
            "description": "planned: not connected or not read yet. wired: physically connected. verified: firmware has read a plausible value from it."
          },
          "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
          "notes": { "type": "string" }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "signal", "medium", "wire_color", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/pin_ref" },
          "to": { "$ref": "#/$defs/pin_ref" },
          "signal": { "type": "string", "minLength": 1 },
          "bus": { "type": ["string", "null"] },
          "medium": { "enum": ["pcb", "qwiic_cable", "wire"], "description": "pcb = trace on the dev kit, drawn as a highlight, not a wire." },
          "wire_color": {
            "type": ["string", "null"],
            "description": "Qwiic code: red 3.3 V, black GND, blue SDA, yellow SCL. null for PCB traces.",
            "enum": ["red", "black", "blue", "yellow", "white", "green", null]
          },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "type": "string" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocks"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "type": "string" },
          "blocks": { "type": "array", "items": { "type": "string" }, "description": "Part or connection ids that stay unverified until answered." }
        }
      }
    }
  }
}
