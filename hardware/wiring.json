  "boot_sequence": [
    {
      "step": 1,
      "action": "Drive SENSOR_EN (UULP_VBAT_GPIO_1) low.",
      "pin": "soc.UULP_VBAT_GPIO_1",
      "reason": "Disconnects Si7021/VEML6035 from I2C2 and unpowers them (UG581 3.4.4), so only Qwiic devices answer. Qwiic power is VMCU, so the VL53L1X stays powered."
    },
    {
      "step": 2,
      "action": "Probe 0x30. If it ACKs and register 0x010F reads model ID 0xEACC, the VL53L1X is already moved (MCU-only reset): go to step 5.",
      "address": "0x30",
      "reason": "The VL53L1X keeps its new address until it loses power, and an MCU reset does not cut VMCU."
    },
    {
      "step": 3,
      "action": "Probe 0x29 and check model ID 0xEACC. Write 0x30 to I2C_SLAVE__DEVICE_ADDRESS (register 0x0001).",
      "address": "0x29",
      "reason": "With the on-board sensors disconnected, 0x29 can only be the VL53L1X."
    },
    {
      "step": 4,
      "action": "Confirm the model ID at 0x30. If neither address answers, publish a sensor_error for fork_distance and never publish a value.",
      "address": "0x30",
      "reason": "No made-up values."
    },
    {
      "step": 5,
      "action": "Drive SENSOR_EN high, wait for the sensors to power up, then initialise Si7021 (0x40) and VEML6035 (0x29).",
      "pin": "soc.UULP_VBAT_GPIO_1",
      "reason": "From here the bus holds VEML6035 0x29, NAU7802 0x2A, VL53L1X 0x30, Si7021 0x40: no clashes."
    }
  ],
