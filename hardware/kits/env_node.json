{
  "version": 1,
  "kit": {
    "id": "env_node",
    "name": "Environment node",
    "asset_type": "environment",
    "status": "reference",
    "radio": {
      "protocol": "thread",
      "chip": "EFR32MG24",
      "reason": "A Thread/Matter mesh covers a whole building from many small nodes, and every mains-powered node is a router for the others.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "usb",
      "description": "5 V USB adapter; a 1000 mAh LiPo keeps it running through power cuts. The particle sensor's fan makes pure battery power impractical."
    },
    "mounting": "Wall-mounted at 1.5 m, away from doors and machines, with the particle sensor's inlet facing down.",
    "purpose": "Temperature, humidity, CO₂ and fine dust (PM2.5) in a room.",
    "captions": [
      "Shows where the air is stale (high CO₂) or dusty.",
      "Feeds heat-index rest reminders for workers.",
      "Talks Thread, so many nodes form one mesh that reaches the whole site."
    ],
    "publishes": [
      {
        "channel": "temperature",
        "unit": "°C",
        "description": "Air temperature (SHT45)"
      },
      {
        "channel": "humidity",
        "unit": "%RH",
        "description": "Relative humidity (SHT45)"
      },
      {
        "channel": "co2_ppm",
        "unit": "ppm",
        "description": "CO₂ (SCD40, photoacoustic NDIR)"
      },
      {
        "channel": "pm25_ugm3",
        "unit": "µg/m³",
        "description": "PM2.5 (SPS30)"
      }
    ],
    "power_budget": {
      "average_ma": 70,
      "peak_ma": 220,
      "supply_v": 5.0,
      "assumptions": "SPS30 fan running continuously (~60 mA at 5 V), SCD40 periodic measurement (~15 mA avg), MG24 Thread router (~10 mA). Estimate."
    },
    "est_battery_life": {
      "days": 1,
      "assumptions": "Back-up LiPo 1000 mAh at ~75 mA with the fan on: about 13 hours. Estimate."
    }
  },
  "board": "BRD2601B",
  "sdk": "reference design (not built)",
