    },
    "power_source": {
      "type": "battery",
      "description": "One CR2032 coin cell in the board's holder."
    },
    "mounting": "Clipped inside the helmet's suspension band; the proximity sensor faces the wearer's forehead.",
    "purpose": "Proves the helmet is worn (presence + motion) and reports hard knocks.",
    "captions": [
      "Confirms the helmet is on the head in zones that need one; a missing helmet gets a reminder, never a penalty.",
      "Notices a hard knock on the helmet."
    ],
