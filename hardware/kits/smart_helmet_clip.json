      "assumptions": "BLE advertising every 5 s, proximity sensor sampled every 10 s, accelerometer in wake-on-shock mode. Estimate."
    },
    "est_battery_life": {
      "days": 250,
      "assumptions": "CR2032 ~220 mAh at ~30 µA average plus self-discharge. Estimate, not measured."
