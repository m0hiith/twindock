  "version": 1,
  "kit": {
    "id": "dock_bay",
    "name": "Dock bay monitor",
    "asset_type": "dock",
    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Mains-powered at the dock door, so Wi-Fi's power draw doesn't matter and the warehouse Wi-Fi is already there.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "mains",
      "description": "24 V DC from the dock door controller, stepped down to 3.3 V."
    },
    "mounting": "Board in the dock controller's enclosure; ToF sensor above the door looking down at the trailer; reed contacts on the door rails.",
    "purpose": "Is a trailer at the door, is the door open or shut, is the leveler out, and the dock light.",
    "captions": [
      "Shows at a glance which dock doors have a trailer and which are open.",
      "Switches the dock light on when a trailer is parked.",
      "Reads the leveler state from the dock's own controller."
    ],
    "publishes": [
      {
        "channel": "occupied",
        "description": "Trailer present (ToF distance)"
      },
      {
        "channel": "door_position",
        "description": "open / closed from the two door contacts"
      },
      {
        "channel": "leveler",
        "description": "deployed / stowed from the leveler controller"
      },
      {
        "channel": "dock_light",
        "description": "Dock light relay state"
      }
    ],
    "power_budget": {
      "average_ma": 90,
      "peak_ma": 250,
      "supply_v": 24.0,
      "assumptions": "SiWx917 connected (~60 mA at 3.3 V), ToF ranging (~20 mA), relay coil when on (~70 mA at 5 V). Estimate."
    }
  },
  "board": "BRD2605A",
  "sdk": "reference design (not built)",
