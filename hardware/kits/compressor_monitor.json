    "asset_type": "utility",
    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Mains-powered in the compressor room; Wi-Fi reaches the utilities block without a mesh.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "mains",
      "description": "24 V DC from the compressor's control supply, stepped down to 3.3 V and 5 V."
    },
    "mounting": "Board in a small box on the compressor room wall; pressure transducer on the receiver tank; dew-point transmitter after the dryer; clamp on the motor.",
    "purpose": "Line pressure, motor current, run hours and dew point.",
    "captions": [
      "Shows the air pressure the factory gets, and when the compressor loads and unloads.",
      "A leak shows up as the compressor running more often.",
      "Wet air damages tools: the dew point says how dry it is."
    ],
    "publishes": [
      {
        "channel": "pressure_bar",
        "unit": "bar",
        "description": "Receiver pressure"
      },
      {
        "channel": "current_a",
        "unit": "A",
        "description": "Motor current"
      },
      {
        "channel": "run_hours",
        "unit": "h",
        "description": "Loaded hours (from current)"
      },
      {
        "channel": "dew_point_c",
        "unit": "°C",
        "description": "Pressure dew point after the dryer"
      }
    ],
    "power_budget": {
      "average_ma": 110,
      "peak_ma": 260,
      "supply_v": 24.0,
      "assumptions": "SiWx917 connected (~60 mA), 4-20 mA loop (up to 20 mA at 24 V), pressure transducer (~5 mA at 5 V). Estimate."
    }
