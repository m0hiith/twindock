{
  "version": 1,
  "kit": {
    "id": "truck_telematics",
    "name": "Truck telematics",
    "asset_type": "truck",
    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Vehicle-powered, so no battery limit; Wi-Fi 6 to the cab's cellular hotspot carries position and events, BLE spots pallet tags.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "vehicle",
      "description": "12 / 24 V vehicle supply through a fuse, a surge diode and a step-down regulator to 3.3 V."
    },
    "mounting": "Board and GNSS in a small IP54 box behind the cab; door contact on the cargo door frame; probe inside the cargo box.",
    "purpose": "Where the truck is, how fast it goes, whether the cargo door is open, cargo temperature and harsh driving.",
    "captions": [
      "Tells the yard where each truck is and how it is being driven.",
      "Warns when the cargo door opens away from a dock, or the cargo gets too warm.",
      "Runs off the truck's own battery; it sends its data over the truck's Wi-Fi hotspot."
    ],
    "publishes": [
      {
        "channel": "speed_kmh",
        "unit": "km/h",
        "description": "Speed over ground (GNSS)"
      },
      {
        "channel": "door_open",
        "description": "Cargo door contact"
      },
      {
        "channel": "cargo_temp_c",
        "unit": "°C",
        "description": "Cargo temperature probe"
      },
      {
        "channel": "harsh_event",
        "description": "Hard brake / hard acceleration / impact from the IMU"
      }
    ],
    "power_budget": {
      "average_ma": 120,
      "peak_ma": 350,
      "supply_v": 12.0,
      "assumptions": "SiWx917 Wi-Fi connected with 5 s reports (~60 mA), GNSS module tracking (~30 mA), IMU and probe (<5 mA), regulator losses. Estimate."
    }
  },
