{
  "version": 1,
  "kit": {
    "id": "machine_monitor",
    "name": "Machine monitor",
    "asset_type": "machine",
    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Mains-powered in the machine cabinet; Wi-Fi carries 1 s vibration and current data without a mesh.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "mains",
      "description": "24 V DC from the machine cabinet supply, stepped down to 3.3 V."
    },
    "mounting": "Board on a DIN-rail carrier in the cabinet; clamp on one motor phase; accelerometer glued to the motor housing; thermocouple on the bearing.",
    "purpose": "Machine state, motor current, vibration, surface temperature and cycle count, without touching the machine's PLC.",
    "captions": [
      "Tells you when a machine is running, idle or stopped with a fault.",
      "Spots a wearing bearing early from rising vibration and heat.",
      "Counts cycles from the machine's own cycle signal."
    ],
    "publishes": [
      {
        "channel": "state",
        "description": "running / idle / fault / maintenance from the stack light and current"
      },
      {
        "channel": "current_a",
        "unit": "A",
        "description": "Motor current (clamp)"
      },
      {
        "channel": "vibration_rms",
        "unit": "mm/s",
        "description": "Vibration velocity RMS (accelerometer)"
      },
      {
        "channel": "temperature_c",
        "unit": "°C",
        "description": "Bearing surface temperature (thermocouple)"
      },
      {
        "channel": "units",
        "description": "Good units (cycle input)"
      },
      {
        "channel": "rejects",
        "description": "Rejected units"
      },
      {
        "channel": "cycle_time_s",
        "unit": "s",
        "description": "Last cycle time"
      },
      {
        "channel": "alarm",
        "description": "Fault text when the stack light goes red"
      }
    ],
    "power_budget": {
      "average_ma": 95,
      "peak_ma": 220,
      "supply_v": 24.0,
      "assumptions": "SiWx917 connected (~60 mA), ADC + accelerometer (~1 mA), thermocouple amp (~1.5 mA), opto inputs (~5 mA). Estimate."
    }
  },
