    "id": "tank_level_node",
    "name": "Tank level node",
    "asset_type": "utility",
    "status": "reference",
    "radio": {
      "protocol": "thread",
      "chip": "EFR32MG24",
      "reason": "Tanks sit at the edge of the site; a mains-powered Thread router extends the mesh there while reporting the level.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "usb",
      "description": "5 V adapter from the pump house supply."
    },
    "mounting": "Ultrasonic transducer in the tank roof through a 1\" gland; board in the pump-house box with the pump contactor's auxiliary contact wired in.",
    "purpose": "Tank level and whether the refill pump runs.",
    "captions": [
      "Shows how full each water tank is.",
      "Warns before a tank runs dry or overflows."
    ],
    "publishes": [
      {
        "channel": "level_pct",
        "unit": "%",
        "description": "Level from the ultrasonic distance and the tank's height"
      },
      {
        "channel": "pump_on",
        "description": "Refill pump contactor"
      }
    ],
    "power_budget": {
      "average_ma": 30,
      "peak_ma": 60,
      "supply_v": 5.0,
      "assumptions": "MG24 Thread router (~10 mA), ultrasonic module (~8 mA), opto input (~3 mA). Estimate."
