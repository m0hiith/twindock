    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Mains-powered beside the conveyor drive; Wi-Fi is already on the shop floor.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "mains",
      "description": "24 V DC from the conveyor control panel, stepped down to 3.3 V."
    },
    "mounting": "Board in the drive's control box; clamp on a motor phase; hall sensor facing a magnet on the tail roller; ToF above the belt before the transfer point.",
    "purpose": "Motor current, belt speed and jams.",
    "captions": [
      "Shows the belt speed and spots a jam before boxes pile up.",
      "A stalled belt draws more current: the clamp sees it."
    ],
    "publishes": [
      {
        "channel": "motor_current_a",
        "unit": "A",
        "description": "Drive motor current (clamp)"
      },
      {
        "channel": "belt_speed_m_s",
        "unit": "m/s",
        "description": "Belt speed from roller pulses"
      },
      {
        "channel": "jam",
        "description": "Box held in front of the ToF sensor too long"
      }
    ],
    "power_budget": {
      "average_ma": 85,
      "peak_ma": 200,
      "supply_v": 24.0,
      "assumptions": "SiWx917 connected (~60 mA), ToF (~20 mA), ADC + hall (<3 mA). Estimate."
    }
  },
