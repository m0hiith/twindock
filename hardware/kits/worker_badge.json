{
  "version": 1,
  "kit": {
    "id": "worker_badge",
    "name": "Worker badge",
    "asset_type": "worker",
    "status": "reference",
    "radio": {
      "protocol": "ble",
      "chip": "EFR32BG27",
      "reason": "Worn all shift on a small battery: Bluetooth LE advertising sips power, and zone gateways locate it by signal strength.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "battery",
      "description": "300 mAh LiPo with a USB-C charger, charged overnight in a rack."
    },
    "mounting": "Clip-on badge on the chest strap or lanyard; motor and buzzer inside the case, SOS button on the front edge.",
    "purpose": "Zone location, falls and man-down, SOS, and buzz/beep/flash alerts for the wearer.",
    "captions": [
      "Lets a worker call for help with one long press.",
      "Notices a fall or someone lying still, and asks before raising the alarm.",
      "Buzzes the wearer when a forklift gets too close or a zone must be evacuated."
    ],
    "publishes": [
      {
        "channel": "position",
        "unit": "m",
        "description": "Zone position from gateway RSSI (computed by the site, not by the badge)"
      }
    ],
    "power_budget": {
      "average_ma": 0.9,
      "peak_ma": 90,
      "supply_v": 3.7,
      "assumptions": "BLE advertising 1 Hz (~15 µA), IMU in low-power motion detection (~10 µA), SHT45 every 30 s (<1 µA), alerts a few seconds a day (motor ~70 mA). Estimate."
    },
    "est_battery_life": {
      "days": 14,
      "assumptions": "300 mAh LiPo at ~0.9 mA average including a handful of alerts per shift; worn 10 h a day. Estimate, not measured."
    }
  },
