  "kit": {
    "id": "gas_detector_node",
    "name": "Gas detector node",
    "asset_type": "environment",
    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Mains-powered with an alarm relay; Wi-Fi gets an alarm to the monitoring room in about a second without depending on a battery mesh.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "mains",
      "description": "24 V DC from the building's safety supply, stepped down to 3.3 V."
    },
    "mounting": "Wall-mounted at breathing height (CO) in the hazardous store and utilities; relay drives a local sounder/beacon.",
    "purpose": "Carbon monoxide and oxygen levels in a zone, with a local alarm relay.",
    "captions": [
      "Warns everyone in and around a zone when gas reaches a dangerous level.",
      "Adds to, never replaces, a certified gas detection system: TwinDock only advises.",
      "Its relay can sound a local beacon even if the network is down."
    ],
    "publishes": [
      {
        "channel": "co_ppm",
        "unit": "ppm",
        "description": "Carbon monoxide (electrochemical cell)"
      },
      {
        "channel": "o2_pct",
        "unit": "%",
        "description": "Oxygen (electrochemical cell)"
      },
      {
        "channel": "alarm",
        "description": "Alarm threshold reached (relay energised)"
      }
    ],
    "power_budget": {
      "average_ma": 95,
      "peak_ma": 250,
      "supply_v": 24.0,
      "assumptions": "SiWx917 connected (~60 mA), gas module (~10 mA), relay coil when in alarm (~70 mA at 5 V). Estimate."
    }
  },
