    "power_source": {
      "type": "mains",
      "description": "24 V DC from the ETP control panel, stepped down to 3.3 V."
    },
    "mounting": "Board in the ETP cabinet; pH and turbidity probes in a flow cell on the inflow or outflow pipe.",
    "purpose": "pH and turbidity of the effluent, at the plant inflow or its outflow.",
    "captions": [
      "Shows whether the treated water leaving the plant is inside its limits.",
      "A pH or cloudiness reading outside the limits raises a warning."
    ],
    "publishes": [
      {
        "channel": "ph",
        "unit": "pH",
        "description": "pH (probe + interface board)"
      },
      {
        "channel": "turbidity_ntu",
        "unit": "NTU",
        "description": "Turbidity (optical sensor)"
      }
    ],
    "power_budget": {
      "average_ma": 80,
      "peak_ma": 200,
      "supply_v": 24.0,
      "assumptions": "SiWx917 connected (~60 mA), probe interface boards (~10 mA each at 5 V), ADC. Estimate."
