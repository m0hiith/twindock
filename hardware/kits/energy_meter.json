  "kit": {
    "id": "energy_meter",
    "name": "Energy meter bridge",
    "asset_type": "energy",
    "status": "reference",
    "radio": {
      "protocol": "wifi",
      "chip": "SiWG917M111MGTBA",
      "reason": "Sits in a mains distribution board; Wi-Fi brings meter readings out of a metal cabinet's gland more reliably than a mesh would.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "din_rail",
      "description": "5 V DIN-rail power supply in the same distribution board, into the dev kit's USB-C."
    },
    "mounting": "DIN-rail meter on the feeder; the bridge board in a DIN-rail enclosure next to it, antenna through the cabinet gland.",
    "purpose": "Power, energy and voltage of one feeder, read from a certified meter over Modbus.",
    "captions": [
      "Shows how much power each building uses right now and today.",
      "The certified meter does the measuring; the bridge only reads it."
    ],
    "publishes": [
      {
        "channel": "power_kw",
        "unit": "kW",
        "description": "Active power"
      },
      {
        "channel": "energy_kwh",
        "unit": "kWh",
        "description": "Imported energy register"
      },
      {
        "channel": "voltage_v",
        "unit": "V",
        "description": "Line voltage"
      }
    ],
    "power_budget": {
      "average_ma": 70,
      "peak_ma": 200,
      "supply_v": 5.0,
      "assumptions": "SiWx917 connected (~60 mA), RS-485 transceiver (~1 mA idle). Estimate."
    }
  },
