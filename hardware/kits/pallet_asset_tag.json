    "status": "reference",
    "radio": {
      "protocol": "ble",
      "chip": "EFR32BG22",
      "reason": "A coin cell must last years: Bluetooth LE advertising every few seconds draws microamps on average, and the warehouse gateways already scan BLE.",
      "evidence": "silabs.com"
    },
    "power_source": {
      "type": "battery",
      "description": "One CR2032 coin cell in the board's holder."
    },
    "mounting": "Screwed or zip-tied to the pallet's side block, button facing out.",
    "purpose": "A pallet that can be found: it advertises its ID, and its button and LED answer a 'find me'.",
    "captions": [
      "Lets the warehouse find a pallet by asking it to blink.",
      "Runs for years on a coin cell because it only talks in short radio blips."
    ],
    "publishes": [
      {
        "channel": "find_me",
        "description": "True while the tag is blinking for a 'find me' request"
      }
    ],
    "power_budget": {
      "average_ma": 0.012,
      "peak_ma": 8,
      "supply_v": 3.0,
      "assumptions": "BLE advertising every 2 s (~5 µA average for the radio), sleep current a few µA, LED blink only on request. Estimate."
    },
    "est_battery_life": {
      "days": 900,
      "assumptions": "CR2032 ~220 mAh usable at 12 µA average, one 10 s find-me a day, room temperature. Estimate, not measured."
    }
  },
